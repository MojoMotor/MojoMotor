{
  "name": "mojomotor/mojomotor",
  "description": "Developer tooling for modernizing MojoMotor compatibility on current PHP versions.",
  "type": "project",
  "require": {},
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "phpcompatibility/php-compatibility": "^9.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint:style": "phpcs -p --standard=phpcs.xml.dist",
    "lint:compat": "phpcs -p --extensions=php --ignore=*/javascript/*,*/compressed/*,*/database/drivers/mysql/*,*/database/drivers/mssql/*,*/database/drivers/sqlite/*,*/database/drivers/oci8/*,*/database/drivers/odbc/*,*/views/themes/default/css/*,*/views/mojo_footer.php,*/views/setup/blank_layout.php --standard=PHPCompatibility --runtime-set testVersion 8.2-8.3 system/mojomotor system/codeigniter/system",
    "verify:encrypt": "php scripts/verify_encrypt_migration.php"
  }
}
